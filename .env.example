# ==============================
# FRIDAY AI Agent - Environment
# ==============================
# Copy this file to .env locally. NEVER commit real secrets.
# Real OAuth tokens/API keys must stay in your local environment or GitHub Secrets.

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Use either a voice ID or a shared ElevenLabs voice URL.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_LINK=https://elevenlabs.io/voice-library/share/your_voice_id

# ==============================
# OmniRoute / GitHub Copilot BYOK
# ==============================
# OmniRoute exposes an OpenAI-compatible /v1 endpoint.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here

# GitHub Copilot CLI provider settings.
# These are consumed by Copilot CLI; keep the API key out of git.
COPILOT_PROVIDER_TYPE=openai
COPILOT_PROVIDER_BASE_URL=http://127.0.0.1:20128/v1
COPILOT_PROVIDER_API_KEY=your_omniroute_api_key_here
COPILOT_MODEL=your_omniroute_model_id_here

# Optional: OmniRoute CLI OAuth bridge.
# Leave OMNIROUTE_TOKEN empty if your local OmniRoute instance does not require it.
OMNIROUTE_SERVER=http://127.0.0.1:20128
OMNIROUTE_TOKEN=
OMNIROUTE_USER_ID=cli

# GitHub Copilot authentication (only needed for GitHub-hosted Copilot features).
# Use a GitHub OAuth token/device login or a supported fine-grained token.
# Do NOT commit a real token here.
COPILOT_GITHUB_TOKEN=

# FRIDAY runtime
FRIDAY_IDENTITY=friday-ai-agent
FRIDAY_INSTRUCTIONS=You are FRIDAY, a real-time mission-control AI assistant. Be concise, technically precise, proactive, and calm under pressure. Use a polished, confident, lightly British-inspired tone.
