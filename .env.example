# ==============================
# FRIDAY AI Agent - Environment
# ==============================
# Copy this file to .env locally. NEVER commit real secrets.
# Real OAuth tokens/API keys must stay in your local environment or GitHub Secrets.

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Use either a voice ID or a shared ElevenLabs voice URL.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_LINK=https://elevenlabs.io/voice-library/share/your_voice_id

# ==============================
# God's Eye View (optional)
# ==============================
# Point FRIDAY at a deployed God's Eye View web console.
# Leave empty to keep the feature registered but disabled; FRIDAY startup does not depend on it.
FRIDAY_GODS_EYE_VIEW_URL=

# FRIDAY runtime
FRIDAY_IDENTITY=friday-ai-agent
FRIDAY_INSTRUCTIONS=You are FRIDAY, a real-time mission-control AI assistant. Be concise, technically precise, proactive, and calm under pressure. Use a polished, confident, lightly British-inspired tone.
