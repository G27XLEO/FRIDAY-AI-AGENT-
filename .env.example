# ==============================
# FRIDAY AI Agent - Environment
# ==============================
# Copy this file to .env locally. NEVER commit real secrets.
# Put real API keys/secrets in your local environment or GitHub Actions Secrets.

# LiveKit
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
# Auto language detection for multilingual recognition (en/hi/mr and more as provider supports)
FRIDAY_MULTILINGUAL_STT=true

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_licensed_voice_id
# Multilingual output; choose a properly licensed voice supporting the target languages
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# If your LiveKit plugin version requires it, set ELEVEN_API_KEY in the host secret store too
# ELEVENLABS_VOICE_LINK=https://elevenlabs.io/app/voice-library?voiceId=your_voice_id

# FRIDAY runtime
FRIDAY_IDENTITY=friday-ai-agent
FRIDAY_INSTRUCTIONS=You are FRIDAY, a real-time mission-control AI assistant. Be concise, technically precise, proactive, and calm under pressure. Reply in the operator language when possible (English Hindi Marathi). Use a calm professional voice character, never a real-person imitation.

# Optional MCP/runtime controls
# FRIDAY_WORKSPACE_ROOT=.
# FRIDAY_MEMORY_PATH=.run/memory.json
# FRIDAY_ALLOWED_COMMANDS=pwd,python,python3,git,find,rg,cat
# FRIDAY_MAX_TEXT_CHARS=6000
# FRIDAY_MAX_WRITE_BYTES=1000000
